<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>MEIFERTS™ Building Intelligence</title>

<style>
:root{
--navy:#1B2B45;
--gold:#B8935A;
--cream:#F3EEE2;
--white:#ffffff;
--text:#1f2933;
--muted:#6b7280;
--line:rgba(27,43,69,.16);
}

*{box-sizing:border-box}

html,body{
margin:0;
padding:0;
overflow-x:hidden;
}

body{
font-family:Inter,Arial,sans-serif;
background:var(--cream);
color:var(--text);
line-height:1.65;
}

header{
padding:28px 5vw;
border-bottom:1px solid var(--line);
display:flex;
justify-content:space-between;
align-items:center;
gap:34px;
flex-wrap:wrap;
background:rgba(243,238,226,.96);
}

.brand{text-decoration:none;color:var(--navy);min-width:240px}

.brand-title{
font-family:Georgia,"Times New Roman",serif;
font-size:28px;
letter-spacing:.12em;
font-weight:500;
text-transform:uppercase;
}

.brand-subtitle{
font-size:13px;
letter-spacing:.20em;
text-transform:uppercase;
color:var(--gold);
font-weight:700;
margin-top:6px;
}

nav{
display:flex;
gap:24px;
align-items:center;
justify-content:flex-end;
flex-wrap:wrap;
}

nav a{
text-decoration:none;
color:var(--navy);
text-transform:uppercase;
letter-spacing:.10em;
font-size:12px;
font-weight:700;
white-space:nowrap;
}

nav a:hover{color:var(--gold)}

.nav-button{
border:1px solid var(--navy);
padding:10px 16px;
}

.nav-button:hover{
background:var(--navy);
color:var(--cream);
}

main{padding:82px 5vw 100px}

.hero{
max-width:1180px;
margin:0 auto 90px;
}

.eyebrow,.section-eyebrow{
color:var(--gold);
text-transform:uppercase;
letter-spacing:.22em;
font-size:12px;
font-weight:700;
margin-bottom:22px;
}

h1{
font-family:Georgia,"Times New Roman",serif;
font-size:clamp(58px,8vw,112px);
line-height:.95;
font-weight:400;
color:var(--navy);
margin:0 0 34px;
max-width:980px;
}

.lead{
font-size:25px;
line-height:1.5;
color:var(--navy);
max-width:860px;
margin:0 0 30px;
}

.hero-text{
font-size:19px;
color:#4b5563;
max-width:760px;
margin:0 0 38px;
}

.actions{
display:flex;
gap:18px;
flex-wrap:wrap;
}

.button{
display:inline-block;
text-decoration:none;
text-transform:uppercase;
letter-spacing:.12em;
font-size:12px;
font-weight:700;
padding:14px 22px;
border:1px solid var(--navy);
color:var(--navy);
}

.button.primary{
background:var(--navy);
color:var(--cream);
}

.button:hover{
background:var(--gold);
border-color:var(--gold);
color:var(--navy);
}

.figure-section{
max-width:1320px;
margin:0 auto 90px;
background:rgba(255,255,255,.35);
border:1px solid var(--line);
padding:26px;
}

.figure-section img{
width:100%;
height:auto;
display:block;
}

.content-section{
max-width:1180px;
margin:0 auto 80px;
background:rgba(255,255,255,.38);
border:1px solid var(--line);
padding:54px 48px;
}

.content-section p{
font-size:18px;
color:#4b5563;
max-width:900px;
margin:0 0 24px;
}

h2{
font-family:Georgia,"Times New Roman",serif;
font-size:clamp(38px,4.6vw,68px);
line-height:1.05;
font-weight:400;
color:var(--navy);
margin:0 0 34px;
}

.standard-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:22px;
margin-top:34px;
}

.standard-card,
.article-card{
border:1px solid rgba(184,147,90,.28);
background:rgba(255,255,255,.52);
padding:30px;
}

.standard-card h3{
font-family:Georgia,"Times New Roman",serif;
font-size:25px;
font-weight:400;
color:var(--navy);
margin:0 0 14px;
}

.standard-card p{
font-size:15px;
margin:0;
}

.evaluation-grid,.client-grid{
display:grid;
grid-template-columns:repeat(5,1fr);
gap:16px;
margin-top:34px;
}

.client-grid{
grid-template-columns:repeat(3,1fr);
}

.evaluation-grid div,.client-grid div{
border-top:1px solid var(--line);
padding-top:16px;
font-family:Georgia,"Times New Roman",serif;
font-size:22px;
color:var(--navy);
}

.behind-section{
max-width:1180px;
margin:0 auto 80px;
display:grid;
grid-template-columns:1fr 1fr;
gap:50px;
align-items:stretch;
}

.behind-panel{
border:1px solid var(--line);
background:rgba(255,255,255,.38);
padding:48px;
}

.behind-panel p{
font-size:18px;
color:#4b5563;
margin:0 0 18px;
}

.signature{
font-family:Georgia,"Times New Roman",serif;
font-size:32px;
line-height:1.25;
color:var(--navy);
margin-top:22px;
}

.article-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:22px;
margin-top:34px;
}

.article-card{
font-family:Georgia,"Times New Roman",serif;
font-size:22px;
line-height:1.3;
color:var(--navy);
min-height:150px;
}

footer{
background:var(--navy);
color:var(--cream);
padding:52px 5vw;
}

.footer-inner{
max-width:1180px;
margin:0 auto;
display:grid;
grid-template-columns:1fr 1fr;
gap:50px;
}

footer h3{
font-family:Georgia,"Times New Roman",serif;
font-size:30px;
font-weight:400;
letter-spacing:.08em;
margin:0 0 18px;
}

footer p{
margin:0 0 16px;
color:rgba(243,238,226,.82);
}

.footer-links{
display:flex;
gap:22px;
flex-wrap:wrap;
justify-content:flex-end;
align-items:flex-start;
}

.footer-links a{
color:var(--cream);
text-decoration:none;
text-transform:uppercase;
letter-spacing:.12em;
font-size:12px;
}

@media(max-width:1100px){
.standard-grid,.article-grid,.behind-section{
grid-template-columns:1fr 1fr;
}

.evaluation-grid{
grid-template-columns:1fr 1fr;
}
}

@media(max-width:760px){
header{align-items:flex-start}

nav{
justify-content:flex-start;
gap:16px 20px;
}

nav a{font-size:11px}

main{padding:56px 5vw 80px}

h1{font-size:clamp(52px,15vw,74px)}

.lead{font-size:20px}

.content-section,.behind-panel{
padding:32px 26px;
}

.figure-section{
padding:12px;
}

.figure-section img{
min-width:720px;
}

.figure-scroll{
overflow-x:auto;
}

.standard-grid,.article-grid,.evaluation-grid,.client-grid,.behind-section,.footer-inner{
grid-template-columns:1fr;
}

.footer-links{justify-content:flex-start}
}
</style>
</head>

<body>

<header>
<a class="brand" href="./">
<div class="brand-title">MEIFERTS™</div>
<div class="brand-subtitle">Building Intelligence™</div>
</a>

<nav>
